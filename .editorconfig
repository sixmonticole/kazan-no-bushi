# Format identique dans tous les éditeurs.
# Les .vue et .ts du projet utilisent 4 espaces (voir .prettierrc.json).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,md,yml,yaml}]
indent_size = 2

[*.{js,mjs}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
